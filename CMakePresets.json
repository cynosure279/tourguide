{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "默认（Debug）",
            "description": "Unix Makefiles + Debug",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            }
        },
        {
            "name": "release",
            "displayName": "发布（Release）",
            "description": "Unix Makefiles + Release",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            }
        }
    ],
    "buildPresets": [
        { "name": "default", "configurePreset": "default", "jobs": 8 },
        { "name": "release", "configurePreset": "release", "jobs": 8 }
    ]
}
